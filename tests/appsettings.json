{
  "EnvironmentName": "Default",
  "BaseUrl": "https://insure.scti.co.nz/",
  "ApiBaseUrl": "https://jsonplaceholder.typicode.com",

  "Timeout": 30000,
  "NavigationTimeout": 60000,
  "ExpectTimeout": 15000,

  "Browser": "chromium",
  "BrowserChannel": "chrome",
  "Headless": true,
  "SlowMo": 0,
  "ViewportWidth": 1366,
  "ViewportHeight": 900,
  "Locale": "en-NZ",
  "TimezoneId": "Pacific/Auckland",

  "DateFormat": "dd/MM/yyyy",
  "CurrencySymbol": "$",

  "Artifacts": {
    "Directory": "playwright-artifacts",
    "TraceOnFailure": true,
    "ScreenshotOnFailure": true
  },

  "Routes": {
    "PlanOptions": "step=plan-options",
    "TravellerDetails": "step=traveller-details"
  },

  "ApiEndpoints": {
    "BasePath": "/api",
    "CreateQuote": "Quotes/create",
    "UpdateExtras": "Quotes/extras",
    "SelectQuote": "Quotes/select"
  }
}
