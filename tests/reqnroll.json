{
  "$schema": "https://schemas.reqnroll.net/reqnroll-config-latest.json",
  "language": {
    "feature": "en"
  },
  "bindingCulture": {
    "name": "en-US"
  },
  "unitTestProvider": {
    "name": "NUnit"
  },
  "trace": {
    "listener": {
      "type": "Reqnroll.Tracing.DefaultListener, Reqnroll"
    }
  },
  "bindingAssemblies": [
    {
      "assembly": "TechnicalTest.Tests"
    }
  ],
  "runtime": {
    "missingOrPendingStepsOutcome": "Pending",
    "obsoleteBehavior": "None"
  }
}
